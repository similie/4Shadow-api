# Foreshadow v2 API (point forecasts + tiles), side by side with the v1 service on :5001.
#   sudo cp deploy/forecast-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now forecast-api
#
# Check the port is free on the host first (ss -ltnp | grep 5003). Workers memory-map the
# store, so they share one copy of the data through the page cache; 2 workers is plenty to
# start. Put a CDN or nginx cache in front: pinned-run tile URLs are immutable.

[Unit]
Description=Foreshadow v2 forecast API
After=network.target

[Service]
User=root
WorkingDirectory=/root/foreshadow-api
EnvironmentFile=-/root/foreshadow-api/.env
ExecStart=/root/foreshadow-api/.venv/bin/uvicorn forecast.api:app --host 0.0.0.0 --port 5003 --workers 2
Restart=always
RestartSec=5
CPUQuota=200%
MemoryHigh=3G
MemoryMax=6G
StandardOutput=append:/root/foreshadow-api/forecast-api.log
StandardError=append:/root/foreshadow-api/forecast-api.log

[Install]
WantedBy=multi-user.target
